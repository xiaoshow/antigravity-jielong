# This repo is scoped ON PURPOSE to a small allowlist of dotfiles/scripts in $HOME.
# Everything is ignored by default; only explicitly un-ignored paths below are tracked.
# Never `git add -A` / `git add .` here — always add specific paths.
*

!/.gitignore
!/codex-widget.py
!/codex-usage.py

# Antigravity & Keychain Token Vault (Private Credentials)
account_vault/
*.token
*.token.*
*_cache.json
last_quota.json
multi_quota_cache.json
!/tools/
!/tools/antigravity-quota-relay/
!/tools/antigravity-quota-relay/**
